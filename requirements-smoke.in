# Provisional Windows/CUDA Phase-A smoke environment.
#
# Compile with uv 0.12.5. The two direct wheel URLs below freeze the Windows
# CUDA 12.8 backend. Do not replace them with PyPI or `--torch-backend=auto`:
# the selected PyTorch artifacts are part of the run identity. A global uv
# torch backend is unsuitable here because it also redirects `torchao`, whose
# CUDA 12.8 wheel is not published for Windows.
#
#   .venv\Scripts\uv.exe pip compile requirements-smoke.in --python-version 3.12 --python-platform windows --generate-hashes --output-file requirements-smoke.lock
#
# TRL 0.24 is intentional. Unsloth 2026.8.18 declares trl<=0.24.0 and
# transformers<=5.5.0, so it cannot share an environment with TRL 1.8. The
# latter remains a separate M6 multi-turn backend candidate.

torch @ https://download.pytorch.org/whl/cu128/torch-2.11.0%2Bcu128-cp312-cp312-win_amd64.whl#sha256=7c78215c3af4f62e63f2b2e360f1722fc719b0853c7ac22666483d9810613a4c
torchvision @ https://download.pytorch.org/whl/cu128/torchvision-0.26.0%2Bcu128-cp312-cp312-win_amd64.whl#sha256=8c0d1c4fbb2c9a4d5d41d0aaa87da20e525bcb2a154ce405725b0be59456804b
xformers @ https://download.pytorch.org/whl/cu128/xformers-0.0.35-py39-none-win_amd64.whl#sha256=57381ce3cbb79b593e6b62cb20a937885345fad2796de2aa6fbb66c033601179
triton-windows @ https://files.pythonhosted.org/packages/62/1e/8d9814e67ba3f20094cf3c69e7815a491f20beb86469a647550ba86728b0/triton_windows-3.6.0.post26-cp312-cp312-win_amd64.whl#sha256=189d8c57911aa9d2ff983a715e5c967b325f576307db60924cab22b501a36515

